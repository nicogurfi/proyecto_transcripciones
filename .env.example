# Copiar a .env (no se commitea). Sin ninguna clave, el sistema arranca en modo simulado (mock).

# auto | mock | anthropic | openai | gemini | groq | ollama
LLM_PROVIDER=auto
# LLM_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=12

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Ollama / vLLM locales (API compatible con OpenAI)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b

# Doble verificación de direcciones con el normalizador USIG (requiere internet; sin red usa la caché local)
USIG_ENABLED=true
